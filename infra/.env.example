# Copie para infra/.env na VPS e preencha. O .env nunca vai para o git.
POSTGRES_PASSWORD=
# Senha do usuário só de leitura da API (firesync_api), a mesma do CREATE ROLE no roteiro de carga
API_DB_PASSWORD=
FIRMS_MAP_KEY=
# Origem exata do front no Cloudflare, sem barra no fim (ex.: https://firesync-prd.<conta>.workers.dev)
FRONTEND_ORIGIN=
# Token do túnel criado em Zero Trust > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
# Idade máxima, em dias, das notas de risco que a API mostra (padrão 2). Com 10, o mapa segura a última nota se o job-risco parar
RISK_MAX_AGE_DAYS=10
